# DOMAIN lấy từ file .env (vd crm.congty.vn) → Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt).
# docker-compose.yml mặc định DOMAIN=:80 (HTTP, chạy thử bằng địa chỉ IP; iPhone chưa cài được app khi chưa có HTTPS).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API: chỉ đường dẫn /api/* được chuyển vào backend (Swagger /docs không lộ ra ngoài)
	handle /api/* {
		request_body {
			max_size 60MB
		}
		reverse_proxy api:8000 {
			transport http {
				response_header_timeout 300s
			}
		}
	}

	# Giao diện tĩnh; mọi đường dẫn khác trả về _shell.html để router phía trình duyệt xử lý
	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		try_files {path} /_shell.html
		file_server
	}
}
