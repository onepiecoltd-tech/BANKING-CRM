# ── Bắt buộc ────────────────────────────────────────────────────────────────
# Tên miền (hoặc tên miền phụ) đã trỏ bản ghi A về IP của VPS. Chưa có thì để :80 (chạy thử bằng HTTP).
DOMAIN=crm.tenmiencuaban.vn

# Mã thiết lập: ai mở trang lần đầu cũng phải nhập mã này mới tạo được tài khoản Admin
# (tránh người lạ vào trước bạn). Đặt chuỗi dài, khó đoán, rồi chỉ bạn giữ.
CRM_SETUP_CODE=

# ── Tùy chọn ────────────────────────────────────────────────────────────────
# Không nạp khách hàng mô phỏng khi chạy thật (1 = có dữ liệu mẫu để xem thử)
CRM_SEED_DEMO=0
CRM_BACKUP_KEEP_DAYS=14

# Trợ lý AI: để trống GEMINI_API_KEY và đặt LLM_BACKEND=ollama nếu không dùng AI đám mây
LLM_BACKEND=gemini
GEMINI_API_KEY=
# Kênh gửi tin: mock = chỉ mô phỏng, KHÔNG gửi thật
SENDER_BACKEND=mock
